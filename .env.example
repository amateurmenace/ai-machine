# API Keys (Optional - only needed for cloud AI providers)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# YouTube API Key (Optional - for playlist access)
# Get one at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key-here

# Server Configuration
# Loopback: the API answers this machine, the console at localhost:3000, and a
# tunnel, and nothing else. 0.0.0.0 opens it to the whole network the machine
# is on, including every administrative route; only do that on purpose.
HOST=127.0.0.1
PORT=8000

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000

# --- Community AI ---------------------------------------------------------

# Local inference. For a server reached over a tunnel, put the public hostname
# here and the tunnel's credential in the project's local auth header.
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Frontier providers, all optional. The point of the project is the local one.
GEMINI_API_KEY=your-gemini-key-here

# Web search backend for the assistant's tools. A self-hosted SearXNG is the
# option that keeps residents' queries inside the community.
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=

# Archive sync. Scans channel sources for new meetings on this interval.
COMMUNITY_SYNC_ENABLED=true
COMMUNITY_SYNC_INTERVAL_MINUTES=360

# Embeddings. Changing this requires re-indexing; see COMMUNITY_AI_SETUP.md.
# COMMUNITY_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Running on Google Cloud (all optional) -------------------------------
#
# Unset means the local behavior, which is the supported one: limits counted in
# this process, uploads on this disk, secrets used as written, request logs in
# JSONL. Each of these needs a client library that is deliberately not in
# requirements.txt, and a missing one degrades to local with a line in the log
# saying what to install. See deploy/README.md, and check what is actually
# running with GET /api/admin/cloud-status.

# The archive in Cloud SQL for PostgreSQL instead of the embedded Qdrant index
# (see stores/ and ROADMAP.md 2.3). This one is not a degrade-to-local backend:
# a configured database that cannot be opened is an error, because answering
# residents from a different archive without saying so would be worse. Create
# the schema and copy an existing corpus with:
#   python3 -m stores.migrate --project your-project-id
# COMMUNITY_DB_URL=postgresql://civic:PASSWORD@/civic?host=/cloudsql/PROJECT:REGION:INSTANCE
# COMMUNITY_DB_POOL_MAX=4

# Rate limits shared by every instance, instead of one count per process.
# COMMUNITY_REDIS_URL=redis://10.0.0.3:6379/0

# Uploaded PDFs in Cloud Storage, which Cloud Run's filesystem is not.
# COMMUNITY_STORAGE_BUCKET=your-project-uploads
# COMMUNITY_STORAGE_PREFIX=uploads

# Request records mirrored to Cloud Logging. The JSONL log stays either way,
# and so does the rule that question text is not recorded unless a project
# turns it on.
# COMMUNITY_CLOUD_LOGGING=false
# COMMUNITY_CLOUD_LOG_NAME=community-ai-requests

# The project that short sm:// secret references resolve in. Any config field
# or variable may hold sm://projects/P/secrets/NAME/versions/latest instead of
# the value itself.
# GOOGLE_CLOUD_PROJECT=your-project

# Where local uploads and logs live.
# COMMUNITY_DATA_ROOT=./data

# Administration from another machine. Everything under /api that changes
# something (create, configure, ingest, delete) is answered only from the
# machine the API runs on unless the request carries this token, and the
# console sends it once it has been entered on the admin page. Unset, the
# safe default: administration is local-only and residents' questions still
# work everywhere. Make it long:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# COMMUNITY_ADMIN_TOKEN=
