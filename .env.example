# API Keys (Optional - only needed for cloud AI providers)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# YouTube API Key (Optional - for playlist access)
# Get one at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key-here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000

# --- Community AI ---------------------------------------------------------

# Local inference. For a server reached over a tunnel, put the public hostname
# here and the tunnel's credential in the project's local auth header.
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Frontier providers, all optional. The point of the project is the local one.
GEMINI_API_KEY=your-gemini-key-here

# Web search backend for the assistant's tools. A self-hosted SearXNG is the
# option that keeps residents' queries inside the community.
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=

# Archive sync. Scans channel sources for new meetings on this interval.
COMMUNITY_SYNC_ENABLED=true
COMMUNITY_SYNC_INTERVAL_MINUTES=360

# Embeddings. Changing this requires re-indexing; see COMMUNITY_AI_SETUP.md.
# COMMUNITY_EMBEDDING_MODEL=all-MiniLM-L6-v2
